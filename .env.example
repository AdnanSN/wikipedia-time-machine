# Copy this file to .env and fill in your local MariaDB password.
# .env is gitignored: it never leaves your machine. Never commit a password.
# scripts/run_sql.py and the web app (app/) read these settings.
WTM_DB_HOST=127.0.0.1
WTM_DB_PORT=3306
WTM_DB_USER=root
WTM_DB_PASSWORD=
WTM_DB_NAME=wiki_time_machine
